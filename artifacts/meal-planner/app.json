{
  "expo": {
    "name": "Sortii - Dinner. Sorted.",
    "slug": "sortiidinnersorted",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sortiidinnersorted",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9FAF9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sortiidinnersorted.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sortii uses your microphone to add items to your shopping list by voice.",
        "NSSpeechRecognitionUsageDescription": "Sortii uses speech recognition to convert your voice into shopping list items."
      }
    },
    "android": {
      "package": "com.sortiidinnersorted.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "name": "Sortii – Dinner. Sorted.",
      "shortName": "Sortii",
      "description": "Your weekly meal planner. Plan dinners, build your shopping list, and eat well.",
      "themeColor": "#2A8F88",
      "backgroundColor": "#FAF8F4",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "en-AU"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@react-native-voice/voice"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "unsplashAccessKey": "cWU-u6hsZoSKXaZJ_-YfD5s09NoHtfmHmuaKZ_LXXF4"
    }
  }
}
